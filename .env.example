# 复制本文件为 .env.local 后按需修改（.env.local 已在 .gitignore 里，不会被提交）
#
# ── 1. 后端接口基址 ────────────────────────────────────────────────
#   - 前后端同域部署（后端就在同一个域名下）：留空，前端走相对路径 /api/xxx
#   - 独立域名：写完整地址，例如 https://你的后端域名.com
VITE_API_BASE_URL=

# ── 2. 数据源开关 ──────────────────────────────────────────────────
#   http（默认）：请求真实后端
#                 POST {VITE_API_BASE_URL}/api/ingredients/recognize  (FormData: image)
#                 POST {VITE_API_BASE_URL}/api/recipes/generate        (JSON: { ingredients })
#   mock：不走网络，用内置假数据 + 模拟延迟，方便离线调 UI
VITE_DATA_SOURCE=http

# 旧的 Mock 开关（可选，仅为兼容老配置）：设为 true 时等同 VITE_DATA_SOURCE=mock
# VITE_USE_MOCK_API=false

# ── 3. 本地开发代理（可选）──────────────────────────────────────────
# 仅在 VITE_API_BASE_URL 留空、且本地起 dev server 时生效：
# 把 /api 请求转发到后端，绕开浏览器跨域（CORS）限制
# VITE_DEV_PROXY_TARGET=http://localhost:8000

# ⚠️ 安全提醒：不要把任何 API Key / Token 写进 .env。
#    Vite 会把 VITE_ 开头的变量打进前端产物，等于直接公开；
#    大模型、云存储等第三方密钥一律放在后端，前端只请求我们自己的业务接口。
